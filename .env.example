# Copy this file to `.env` on the Raspberry Pi and fill in real values.
# `.env` itself is gitignored and must never be committed.

# Flask session signing. Generate a strong value, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# Turn debug OFF for a real deployment.
FLASK_DEBUG=false

# Port to bind to (gunicorn/app both honour this). 5000 is the default.
PORT=5000

# --- Datastore (MariaDB) ---------------------------------------------------
# The app stores its data (accounts, resumes, job posts, pricing, etc.) here
# via the Firestore-compatible shim in dbstore.py. Unset -> the app runs in its
# public, no-account mode.
#   MariaDB / MySQL:  mysql://user:password@localhost:3306/resumify
#   Local dev / test: sqlite:////absolute/path/to/resumify.db
DATABASE_URL=mysql://resumify:changeme@localhost:3306/resumify

# --- AI generation ---------------------------------------------------------
# Required for resume / cover-letter / CV generation.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional: grounded job / plagiarism search.
GEMINI_API_KEY=

# --- Firebase / Firestore --------------------------------------------------
# Local-file approach: put the service-account JSON next to app.py and point
# to it here. (Alternatively set FIREBASE_CREDENTIALS_JSON to the full JSON.)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
# Optional: Google sign-in. Public web API key; leave blank to hide the button.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=

# --- Email (weekly job-alert send from the admin panel) --------------------
# Provider-agnostic SMTP. Leave blank to keep the "Send" buttons disabled.
# Gmail example: host smtp.gmail.com, port 587, user your address, pass an
# app password (not your login password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set to false only for an SMTP server without STARTTLS.
SMTP_TLS=true

# --- Find Jobs -------------------------------------------------------------
GREENHOUSE_BOARDS=figma,gitlab,discord
LEVER_COMPANIES=leverdemo
WWR_CATEGORY=remote-programming-jobs
FETCH_DELAY_SECONDS=1.0
# Optional extras
RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
